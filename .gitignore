# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# artova
/.captures/
/.ref/
/public/uploads/*
!/public/uploads/.gitkeep

# applications mobiles
/mobile/app/node_modules/
/mobile/app/ios/App/App/public/
/mobile/app/ios/App/App/GoogleService-Info.plist
/mobile/android/.gradle/
/mobile/android/app/build/
/mobile/android/build/
/mobile/android/local.properties
/mobile/android/*.apk
/mobile/android/*.aab
*.jks
*.keystore
*.p8
